main := () {
    # 'if-else' statement
    if False {
        $println("false")
    } else if True {
        $println("true")
    } else {
        $println("unreachable")
    }

    # 'if-else' expression (similar to statement)
    x := if False {
        10
    } else if True {
        20
    } else {
        30
    }

    $print("x: ")
    $println(x)

    cond := True

    if cond {
        $println("`cond` is true")
    } else {
        $println("`cond` is false")
    }
}
