main := () {
    # 'if-else' statement
    if false {
        $println("false")
    } else if true {
        $println("true")
    } else {
        $println("unreachable")
    }

    # 'if-else' expression (similar to statement)
    x := if false {
        10
    } else if true {
        20
    } else {
        30
    }

    $print("x: ")
    $println(x)

    cond := true

    if cond {
        $println("`cond` is true")
    } else {
        $println("`cond` is false")
    }
}
