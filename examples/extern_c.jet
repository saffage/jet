@[extern_c]
malloc: (size: Nat64) -> Pointer

@[extern_c]
free: (p: Pointer) -> ()

main := () {
    x := malloc($size_of(Int)) as *Int
    defer {
        $print("after free: ")
        $println(x as Nat64)
    }
    defer {
        free(x)
        x = 0 as *Int
    }

    $print("x: ")
    $println(x as Nat64)
}
