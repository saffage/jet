@[extern_c("scanf")]
scanf: (@[const_c] format: String, args: ...) -> Int

@[extern_c("rand")]
rand: () -> Int

@[extern_c("srand")]
rand_seed: (seed: Nat32) -> ()

@[extern_c("time")]
time_now: (dest: *Int64) -> Int64

rand_int := (min: Int, max: Int) -> Int { rand() % { max + 1 - min } + min }

main := () {
    attempts := 0
    guess    := 0
    exit     := False

    $print("Welcome to the Guess the Number!")
    rand_seed(time_now(0 as *Int64) as Nat32)
    number_to_guess := rand_int(1, 100)

    while !exit {
        attempts += 1
        $print("\nEnted your guess: ")
        error := scanf("%d", &guess)

        if error == 0 {
            $println("Invalid input!")
            exit = True
        } else if guess < number_to_guess {
            $print("Too low")
            ;
        } else if guess > number_to_guess {
            $print("Too high")
            ;
        } else {
            $print("You've guessed the number in ")
            $print(attempts)
            $println(" attempts")
            exit = True
        }
    }
}
