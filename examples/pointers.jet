T := struct { field: Int }

main := () {
    {
        t     := T(field = 2)
        t_ptr := &t
        t_ptr.*.field = 12 # `.*` for dereference
        $assert(t.field == 12)
    }
    {
        x := [1, 2]
        y := &x
        { { { y as Nat64 } + $size_of(Int) } as *Int }.* = 1
        $assert(x[0] == 1)
        $assert(x[1] == 1)
    }
}
