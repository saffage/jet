## This module contains C type declarations and other tools for interacting
## with C backend.

target! "c"

type Byte       = external(c_type: "char")
type Char       = external(c_type: "char")
type Short      = external(c_type: "short")
type Int        = external(c_type: "int")
type Long       = external(c_type: "long")
type Longlong   = external(c_type: "long long")
type UChar      = external(c_type: "unsigned char")
type UShort     = external(c_type: "unsigned short")
type UInt       = external(c_type: "unsigned int")
type ULong      = external(c_type: "unsigned long")
type ULongLong  = external(c_type: "unsigned long long")
type Float      = external(c_type: "float")
type Double     = external(c_type: "double")
type LongDouble = external(c_type: "long double")
type Pointer    = external(c_type: "void*")
type String     = external(c_type: "char*")
