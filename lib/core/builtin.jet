## This module contains the declaration of the Jet built-ins.

type Int     = external(builtin: "Int")
type Int8    = external(builtin: "Int8")
type Int16   = external(builtin: "Int16")
type Int32   = external(builtin: "Int32")
type Int64   = external(builtin: "Int64")
type Nat     = external(builtin: "Nat")
type Nat8    = external(builtin: "Nat8")
type Nat16   = external(builtin: "Nat16")
type Nat32   = external(builtin: "Nat32")
type Nat64   = external(builtin: "Nat64")
type Float   = external(builtin: "Float")
type Float32 = external(builtin: "Float32")
type Float64 = external(builtin: "Float64")
type String  = external(builtin: "String")
type Char    = external(builtin: "Char")

## {Result} that represents the outcome of an operation.
## It can either be a {Success} or a {Failure}.
type Result(
    success, ## The type representing a successful result.
    failure, ## The type representing a failure or error.
) {
    Failure(failure)
    Success(success)
}

type Bool { False; True }

## Represents a state that will never be reached.
type Never = external(builtin: "never")

## Built-in function that causes panic in the current thread.
##
## After its call the control thread will not be returned to the
## caller and stack unwinding will start.
let panic(with: message String) Never = external(builtin: "panic")
