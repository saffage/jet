Bool    := $builtin("Bool")
Int     := $builtin("I32")
Int8    := $builtin("I8")
Int16   := $builtin("I16")
Int32   := $builtin("I32")
Int64   := $builtin("I64")
Nat     := $builtin("U32")
Nat8    := $builtin("U8")
Nat16   := $builtin("U16")
Nat32   := $builtin("U32")
Nat64   := $builtin("U64")
Float   := $builtin("F32")
Float32 := $builtin("F32")
Float64 := $builtin("F64")
String  := $builtin("String")
Char    := $builtin("Char")
Pointer := $builtin("Pointer")

